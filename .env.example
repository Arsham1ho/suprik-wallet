# Suprik Wallet Environment Variables
# Copy this file to .env and fill in your API keys

# ===========================================
# BLOCKCHAIN RPC PROVIDERS
# ===========================================

# Helius API Key (Required for Solana)
# Get your free key at: https://helius.dev
# Used for: Solana balance queries, token fetching, transaction history
VITE_HELIUS_API_KEY=your_helius_api_key_here

# Alchemy API Key (Optional - for Ethereum/Polygon)
# Get your free key at: https://alchemy.com
# Used for: Ethereum and Polygon balance queries
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# ===========================================
# DEX / SWAP PROVIDERS
# ===========================================

# Jupiter API Key (Required for Swaps)
# Get your free key at: https://portal.jup.ag/api-keys
# Used for: Token swaps via Jupiter Ultra API
VITE_JUPITER_API_KEY=your_jupiter_api_key_here

# ===========================================
# NOTES
# ===========================================
# - All keys are optional for development (will show warnings)
# - For production, at minimum set VITE_HELIUS_API_KEY for Solana support
# - Users can also add their own API keys in Settings > API Keys
# - User-provided keys are encrypted with AES-256-GCM before storage
